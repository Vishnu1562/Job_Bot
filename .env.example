# Power Platform Job Radar - Local Environment Configuration
# Copy this file to .env for local testing

# Free Brevo SMTP Relay (Default: smtp-relay.brevo.com:587)
# Or set to smtp.gmail.com if using Gmail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Your Brevo SMTP Login email (or Gmail address)
SENDER_EMAIL=your-email@example.com

# Your Brevo SMTP Master Key (or Google App Password)
SENDER_PASSWORD=your_smtp_key_here

# Default recipient email (used for all profiles unless overridden below)
RECIPIENT_EMAIL=your-inbox@gmail.com

# Optional: Dedicated recipient emails per profile
# RECIPIENT_EMAIL_POWERPLATFORM=person1@gmail.com
# RECIPIENT_EMAIL_FULLSTACK=person2@gmail.com
# RECIPIENT_EMAIL_JAVA=person3@gmail.com

# Optional database path (defaults to jobs.db in project root)
# DB_PATH=jobs.db
